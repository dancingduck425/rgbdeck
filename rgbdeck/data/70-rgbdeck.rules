# RGB Deck: let the logged-in user talk to supported RGB devices directly (generated by tools/gen_udev_rules.py).
# Install:  sudo install -m644 70-rgbdeck.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger

